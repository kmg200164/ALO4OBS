@echo off
setlocal
set "ALO4OBS_BUNDLE_ROOT=%~dp0"
set "ALO4OBS_PORTABLE_ROOT="
set "ALO4OBS_NO_OPEN="
if /I "%~1"=="/portable" set "ALO4OBS_PORTABLE_ROOT=%~2"
if /I "%~3"=="/no-open" set "ALO4OBS_NO_OPEN=1"
set "ALO4OBS_CHECK_ONLY="
if /I "%~1"=="/check" set "ALO4OBS_CHECK_ONLY=1"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; Import-Module (Join-Path $PSHOME 'Modules/Microsoft.PowerShell.Security/Microsoft.PowerShell.Security.psd1') -ErrorAction Stop; function Hash($path) { $stream=[IO.File]::OpenRead($path); try { $h=[Security.Cryptography.SHA256]::Create(); try { return ([BitConverter]::ToString($h.ComputeHash($stream))).Replace('-','').ToLowerInvariant() } finally { $h.Dispose() } } finally { $stream.Dispose() } }; try { if($env:PROCESSOR_ARCHITECTURE -ne 'AMD64'){throw 'Windows x64 is required.'}; $root=Join-Path $env:ALO4OBS_BUNDLE_ROOT 'files'; $payloadName='payload'; $manifest=Get-Content -LiteralPath (Join-Path $root 'plugin/manifest.json') -Raw | ConvertFrom-Json; $portable=$env:ALO4OBS_PORTABLE_ROOT; $exe=if($portable){if(-not(Test-Path -LiteralPath (Join-Path $portable 'portable_mode.txt'))){throw 'Portable marker missing'}; Join-Path $portable 'bin/64bit/obs64.exe'}else{Join-Path $env:ProgramFiles 'obs-studio/bin/64bit/obs64.exe'}; if(-not(Test-Path -LiteralPath $exe)){throw 'OBS x64 was not found in the standard location.'}; $pe=[IO.File]::ReadAllBytes($exe); if($pe.Length -lt 64){throw 'OBS executable architecture is unknown.'}; $offset=[BitConverter]::ToInt32($pe,60); if($offset -lt 0 -or $offset+6 -gt $pe.Length -or [BitConverter]::ToUInt32($pe,$offset) -ne 17744 -or [BitConverter]::ToUInt16($pe,$offset+4) -ne 34404){throw 'OBS executable must be PE x64.'}; if((Get-Item -LiteralPath $exe).VersionInfo.ProductVersion -notmatch '^(30|31|32|33)\.'){throw 'Only OBS 30-33 has a verified package mapping.'}; $major=[int]((Get-Item -LiteralPath $exe).VersionInfo.ProductVersion.Split('.')[0]); if($major -eq 33){if($portable){throw 'OBS 33+ portable install layout is not verified. No files changed.'}; $payloadName='payload-modern'; $manifest=Get-Content -LiteralPath (Join-Path $root 'plugin/manifest-modern.json') -Raw | ConvertFrom-Json}; $dll=Join-Path $root ('plugin/'+$payloadName+'/bin/64bit/obs-composite-blur.dll'); if((Get-AuthenticodeSignature -LiteralPath $dll).Status -ne 'Valid'){throw 'Plugin signature validation failed.'}; $target=Join-Path $env:ProgramData 'obs-studio/plugins/obs-composite-blur'; function Destination($name){if($portable){if($name.StartsWith('bin/64bit/')){return Join-Path $portable ('obs-plugins/64bit/'+$name.Substring(10))}; return Join-Path $portable ('data/obs-plugins/obs-composite-blur/'+$name.Substring(5))};return Join-Path $target $name}; foreach($file in $manifest.files.PSObject.Properties){$from=Join-Path (Join-Path $root ('plugin/'+$payloadName)) $file.Name; if((Hash $from) -ne $file.Value){throw ('Bundle checksum mismatch: '+$file.Name)}; $to=Destination $file.Name; if((Test-Path -LiteralPath $to) -and (Hash $to) -ne $file.Value){throw 'A different Composite Blur is installed. No files were changed.'}}; if($env:ALO4OBS_CHECK_ONLY -eq '1'){Write-Host 'Verified. No files changed.'; exit 0}; if(Get-Process -Name obs64 -ErrorAction SilentlyContinue | Where-Object {(-not $_.Path) -or $_.Path -eq $exe}){throw 'Close OBS first, then run this file again. OBS was not stopped.'}; foreach($file in $manifest.files.PSObject.Properties){$from=Join-Path (Join-Path $root ('plugin/'+$payloadName)) $file.Name; $to=Destination $file.Name; New-Item -ItemType Directory -Force -Path (Split-Path -Parent $to) | Out-Null; if(-not(Test-Path -LiteralPath $to)){Copy-Item -LiteralPath $from -Destination $to}; if((Hash $to) -ne $file.Value){throw 'Installed checksum mismatch'}}; Write-Host 'Plugin ready. Reopen OBS and Apply saved settings.'; if($env:ALO4OBS_NO_OPEN -ne '1'){Start-Process -FilePath (Join-Path $root 'settings.html')} } catch { Write-Host ('Install failed: '+$_.Exception.Message); exit 1 }"
set "ALO4OBS_RESULT=%ERRORLEVEL%"
if not "%ALO4OBS_CHECK_ONLY%"=="1" if not "%ALO4OBS_NO_OPEN%"=="1" pause
exit /b %ALO4OBS_RESULT%
